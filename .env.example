# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# Comma-separated chat ids the bot is allowed to serve (find via /id or logs on first run).
# Leave empty to allow all chats (not recommended once configured).
ALLOWED_CHAT_IDS=[]

# Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides
# ROUTER_MODEL=claude-haiku-4-5
# ANSWER_MODEL=claude-sonnet-4-6
# DIGEST_MODEL=claude-haiku-4-5

# Which chat the nightly digest (M5) summarises. Defaults to the first of
# ALLOWED_CHAT_IDS, so this is only needed if you serve more than one chat.
# DIGEST_CHAT_ID=-100123456789
